{
  "name": "speedy-desktop",
  "productName": "Speedy",
  "version": "1.2.0",
  "description": "Speedy — fast media and file downloader (desktop client)",
  "author": {
    "name": "Ayanlowo Olatunji Ayobami"
  },
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/teejayfpi/speedy.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ayanlowo.speedy",
    "productName": "Speedy",
    "copyright": "Copyright © 2026 Ayanlowo Olatunji Ayobami",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "build/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Speedy"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "maintainer": "Ayanlowo Olatunji Ayobami"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
